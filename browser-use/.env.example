# Wirebox API Credentials
# Get your API key from Wirebox or let the CLI auto-signup for you!
WIREBOX_API_KEY=wb_live_your_api_key_here
WIREBOX_EMAIL=agent-xxxxxx@wireboxmail.com
WIREBOX_API_URL=https://api.wirebox.sh/v1

# LLM Provider Key (Provide ANY ONE of the following):
# Option A: Browser Use Cloud Key (https://browser-use.com)
BROWSER_USE_API_KEY=
# Option B: OpenAI (defaults to gpt-4o)
OPENAI_API_KEY=
# Option C: Anthropic Claude (defaults to claude-3-5-sonnet)
ANTHROPIC_API_KEY=

# Option D: DeepSeek (https://api.deepseek.com)
# OPENAI_API_KEY=sk-your-deepseek-key
# OPENAI_API_BASE=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# Optional: Specific model override (e.g. gpt-4o, claude-3-5-sonnet-20241022, deepseek-chat, bu-2-0)
LLM_MODEL=
