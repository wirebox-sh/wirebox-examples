# Wirebox Console API Key (required)
# Get yours from https://wirebox.sh/console or create one with `wirebox me`
WIREBOX_API_KEY=wb_live_your_api_key_here

# Optional: Override API base URL (defaults to production https://api.wirebox.sh)
WIREBOX_BASE_URL=https://api.wirebox.sh

# Optional: Local server port for receiving webhooks via Tunnel (default: 3456)
PORT=3456

# Optional: Custom handle prefix for the demo agent (default: webhook-demo)
AGENT_HANDLE_PREFIX=webhook-demo
